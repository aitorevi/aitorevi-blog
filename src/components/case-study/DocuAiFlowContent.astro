---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/shared/Button.astro';
import Tag from '@/components/shared/Tag.astro';
import StackCard from '@/components/case-study/StackCard.astro';
import FeatureCard from '@/components/case-study/FeatureCard.astro';
import CopyButton from '@/components/shared/CopyButton.astro';
import LightboxImage from '@/components/shared/LightboxImage.astro';
import { t } from '@/i18n/utils';
import type { Lang } from '@/i18n/types';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const repoUrl = 'https://github.com/aitorevi/docu-ai-flow';
const packageUrl = 'https://github.com/aitorevi/docu-ai-flow/pkgs/container/docu-ai-flow';

// Los comandos que la sección "Pruébalo" muestra tal cual. Se copian con CopyButton, que
// busca `.code-block-wrapper > pre > code`, así que el marcado de abajo respeta esa estructura.
const seedCommand = 'docker run --rm -v "$PWD/data:/app/data" \\\n  ghcr.io/aitorevi/docu-ai-flow:latest make-samples /app/data/inbox';
const runCommand = 'docker run --rm -p 8080:8080 -v "$PWD/data:/app/data" \\\n  ghcr.io/aitorevi/docu-ai-flow:latest';

const solutionKeys = ['watcher', 'extraction', 'ocr', 'review', 'export', 'dispatch'] as const;
const decisions = ['hexagonal', 'extraction', 'trust', 'result', 'runnable', 'agents'] as const;
const workflowKeys = ['orchestrator', 'agents', 'skills', 'tdd'] as const;

const stack = {
  backend: ['.NET 10', 'C#', 'Hexagonal', 'Result/Error', 'SQLite', 'PdfPig', 'Google Document AI', 'Tesseract', 'Resend', 'Polly'],
  frontend: ['Astro 6', 'TypeScript', 'Docker', 'GHCR', 'GitHub Actions'],
  tests: ['xUnit', 'NSubstitute', 'WireMock.Net', 'NetArchTest', 'WebApplicationFactory'],
};

const githubIcon =
  'M12 .5C5.37.5 0 5.87 0 12.5a12 12 0 0 0 8.21 11.41c.6.11.82-.26.82-.58v-2.23c-3.34.73-4.04-1.61-4.04-1.61-.55-1.4-1.33-1.78-1.33-1.78-1.08-.74.08-.73.08-.73 1.2.08 1.83 1.24 1.83 1.24 1.07 1.83 2.8 1.3 3.49.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.95 0-1.32.47-2.39 1.24-3.24-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.24a11.4 11.4 0 0 1 6 0c2.29-1.56 3.3-1.24 3.3-1.24.66 1.66.24 2.88.12 3.18.77.85 1.23 1.92 1.23 3.24 0 4.62-2.81 5.65-5.49 5.94.43.38.82 1.12.82 2.26v3.35c0 .32.22.7.83.58A12 12 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z';
---

<Layout
  title={t(lang, 'portfolio.docuaiflow.title')}
  description={t(lang, 'portfolio.docuaiflow.subtitle')}
  lang={lang}
  ogImage="/og/work/docu-ai-flow.png"
>
  <div class="relative bg-slate-50 text-ink-900 dark:bg-ink-900 dark:text-slate-100">

    <!-- Hero -->
    <section class="relative overflow-hidden py-8 pt-24 sm:py-12 sm:pt-28" aria-labelledby="daf-hero">
      <div class="absolute inset-0 bg-gradient-to-b from-emerald-500/5 to-transparent dark:from-emerald-400/5" aria-hidden="true" />
      <div class="relative mx-auto max-w-5xl px-6 text-center">
        <Tag variant="raw" label={t(lang, 'portfolio.docuaiflow.tag')} class="border-emerald-500/20 bg-emerald-500/10 text-emerald-700 dark:border-emerald-400/30 dark:bg-emerald-400/10 dark:text-emerald-400" />
        <h1 id="daf-hero" class="mt-6 font-display text-4xl font-bold tracking-tight text-ink-900 dark:text-slate-200 sm:text-5xl">
          {t(lang, 'portfolio.docuaiflow.title')}
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-400">
          {t(lang, 'portfolio.docuaiflow.hero.intro')}
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <Button href={repoUrl} target="_blank" tone="emerald" variant="gradient">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
              <path d={githubIcon} />
            </svg>
            <span>{t(lang, 'portfolio.docuaiflow.hero.cta.repo')}</span>
          </Button>
        </div>
      </div>
    </section>

    <!-- Problem -->
    <section class="py-20 sm:py-24" aria-labelledby="daf-problem">
      <div class="mx-auto max-w-3xl px-6">
        <h2
          id="daf-problem"
          class="text-center font-display text-3xl font-bold tracking-tight text-ink-900 dark:text-slate-200 sm:text-4xl"
        >
          {t(lang, 'portfolio.docuaiflow.problem.title')}
        </h2>
        <p class="mx-auto mt-6 max-w-2xl text-center text-base leading-relaxed text-slate-600 dark:text-slate-400">
          {t(lang, 'portfolio.docuaiflow.problem.text')}
        </p>
      </div>
    </section>

    <!-- Solution -->
    <section class="py-20 sm:py-24" aria-labelledby="daf-solution">
      <div class="mx-auto max-w-5xl px-6">
        <h2
          id="daf-solution"
          class="text-center font-display text-3xl font-bold tracking-tight text-ink-900 dark:text-slate-200 sm:text-4xl"
        >
          {t(lang, 'portfolio.docuaiflow.solution.title')}
        </h2>
        <ul class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {solutionKeys.map((key) => (
            <FeatureCard
              title={t(lang, `portfolio.docuaiflow.solution.${key}`)}
              text={t(lang, `portfolio.docuaiflow.solution.${key}.desc`)}
            />
          ))}
        </ul>

        <figure class="mt-12">
          <LightboxImage
            src="/images/portfolio/docu-ai-flow/review.png"
            alt={t(lang, 'portfolio.docuaiflow.shot.review')}
            caption={t(lang, 'portfolio.docuaiflow.shot.review')}
            closeLabel={t(lang, 'misc.close')}
            class="overflow-hidden rounded-2xl border border-slate-200 shadow-xl dark:border-white/10"
          />
          <figcaption class="mt-3 text-center text-sm text-slate-500 dark:text-slate-400">
            {t(lang, 'portfolio.docuaiflow.shot.review')}
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- Try it -->
    <section class="py-20 sm:py-24" aria-labelledby="daf-try">
      <div class="mx-auto max-w-3xl px-6">
        <h2
          id="daf-try"
          class="text-center font-display text-3xl font-bold tracking-tight text-ink-900 dark:text-slate-200 sm:text-4xl"
        >
          {t(lang, 'portfolio.docuaiflow.try.title')}
        </h2>
        <p class="mx-auto mt-6 max-w-2xl text-center text-base leading-relaxed text-slate-600 dark:text-slate-400">
          {t(lang, 'portfolio.docuaiflow.try.intro')}
        </p>

        <ol class="mt-10 space-y-6">
          {[
            { n: '1', label: t(lang, 'portfolio.docuaiflow.try.step1'), cmd: seedCommand },
            { n: '2', label: t(lang, 'portfolio.docuaiflow.try.step2'), cmd: runCommand },
          ].map((step) => (
            <li>
              <div class="flex items-baseline gap-3">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/10 font-mono text-xs font-bold text-emerald-700 dark:bg-emerald-400/10 dark:text-emerald-400">
                  {step.n}
                </span>
                <span class="text-sm text-slate-600 dark:text-slate-400">{step.label}</span>
              </div>
              <div class="code-block-wrapper relative mt-2.5 overflow-hidden rounded-xl border border-slate-200 bg-ink-900 dark:border-white/10">
                <div class="absolute right-2 top-2 z-10">
                  <CopyButton
                    copyLabel={t(lang, 'portfolio.docuaiflow.try.copy')}
                    copiedLabel={t(lang, 'portfolio.docuaiflow.try.copied')}
                  />
                </div>
                <pre class="overflow-x-auto px-4 py-3.5 pr-12"><code class="font-mono text-[12.5px] leading-relaxed text-slate-200">{step.cmd}</code></pre>
              </div>
            </li>
          ))}
        </ol>

        <p class="mx-auto mt-8 max-w-2xl rounded-xl border border-emerald-500/20 bg-emerald-500/5 px-5 py-4 text-center text-sm leading-relaxed text-slate-700 dark:border-emerald-400/20 dark:bg-emerald-400/5 dark:text-slate-300">
          {t(lang, 'portfolio.docuaiflow.try.payoff')}
        </p>

        <figure class="mt-10">
          <LightboxImage
            src="/images/portfolio/docu-ai-flow/panel.png"
            alt={t(lang, 'portfolio.docuaiflow.shot.panel')}
            caption={t(lang, 'portfolio.docuaiflow.shot.panel')}
            closeLabel={t(lang, 'misc.close')}
            class="overflow-hidden rounded-2xl border border-slate-200 shadow-xl dark:border-white/10"
          />
          <figcaption class="mt-3 text-center text-sm text-slate-500 dark:text-slate-400">
            {t(lang, 'portfolio.docuaiflow.shot.panel')}
          </figcaption>
        </figure>

        <div class="mt-8 flex justify-center">
          <Button href={packageUrl} target="_blank" tone="emerald" variant="ghost">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
              <path d="M21 8v8a2 2 0 0 1-1 1.73l-7 4a2 2 0 0 1-2 0l-7-4A2 2 0 0 1 3 16V8a2 2 0 0 1 1-1.73l7-4a2 2 0 0 1 2 0l7 4A2 2 0 0 1 21 8Z" />
              <path d="m3.3 7 8.7 5 8.7-5" />
              <path d="M12 22V12" />
            </svg>
            <span>{t(lang, 'portfolio.docuaiflow.try.package')}</span>
          </Button>
        </div>
      </div>
    </section>

    <!-- Tech Stack -->
    <section class="py-20 sm:py-24" aria-labelledby="daf-stack">
      <div class="mx-auto max-w-5xl px-6">
        <h2
          id="daf-stack"
          class="text-center font-display text-3xl font-bold tracking-tight text-ink-900 dark:text-slate-200 sm:text-4xl"
        >
          {t(lang, 'portfolio.docuaiflow.stack.title')}
        </h2>
        <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-3">
          {Object.entries(stack).map(([category, items]) => (
            <StackCard
              title={t(lang, `portfolio.docuaiflow.stack.${category}`)}
              items={items}
              titleClass="text-emerald-700 dark:text-emerald-400"
              tagClass="border-emerald-500/20 bg-emerald-500/10 text-emerald-700 dark:border-emerald-400/30 dark:bg-emerald-400/10 dark:text-emerald-400"
            />
          ))}
        </div>
      </div>
    </section>

    <!-- Technical Decisions -->
    <section class="py-20 sm:py-24" aria-labelledby="daf-decisions">
      <div class="mx-auto max-w-5xl px-6">
        <h2
          id="daf-decisions"
          class="text-center font-display text-3xl font-bold tracking-tight text-ink-900 dark:text-slate-200 sm:text-4xl"
        >
          {t(lang, 'portfolio.docuaiflow.decisions.title')}
        </h2>
        <ul class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {decisions.map((key) => (
            <FeatureCard
              title={t(lang, `portfolio.docuaiflow.decisions.${key}.heading`)}
              text={t(lang, `portfolio.docuaiflow.decisions.${key}.text`)}
            />
          ))}
        </ul>
      </div>
    </section>

    <!-- Built with Claude Code -->
    <section class="py-20 sm:py-24" aria-labelledby="daf-workflow">
      <div class="mx-auto max-w-5xl px-6">
        <h2
          id="daf-workflow"
          class="text-center font-display text-3xl font-bold tracking-tight text-ink-900 dark:text-slate-200 sm:text-4xl"
        >
          {t(lang, 'portfolio.docuaiflow.workflow.title')}
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-center text-base leading-relaxed text-slate-600 dark:text-slate-400">
          {t(lang, 'portfolio.docuaiflow.workflow.intro')}
        </p>
        <ul class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {workflowKeys.map((key) => (
            <FeatureCard
              title={t(lang, `portfolio.docuaiflow.workflow.${key}`)}
              text={t(lang, `portfolio.docuaiflow.workflow.${key}.desc`)}
            />
          ))}
        </ul>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 sm:py-24" aria-labelledby="daf-cta">
      <div class="mx-auto max-w-2xl px-6 text-center">
        <h2 id="daf-cta" class="font-display text-2xl font-bold tracking-tight text-ink-900 dark:text-slate-200 sm:text-3xl">
          {t(lang, 'portfolio.docuaiflow.cta.title')}
        </h2>
        <p class="mx-auto mt-3 text-base leading-relaxed text-slate-600 dark:text-slate-400">
          {t(lang, 'portfolio.docuaiflow.cta.text')}
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <Button href={repoUrl} target="_blank" tone="emerald" variant="gradient">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
              <path d={githubIcon} />
            </svg>
            <span>{t(lang, 'portfolio.docuaiflow.cta.repo')}</span>
          </Button>
        </div>
      </div>
    </section>

  </div>
</Layout>
